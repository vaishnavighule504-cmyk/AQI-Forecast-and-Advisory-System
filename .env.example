# Copy this file to ".env" in your project root and fill in your real token.
# Get a free token at: https://aqicn.org/data-platform/token/

WAQI_API_TOKEN=your_waqi_api_token_here
CPCB_API_KEY=your_api_key_here

# Database Configuration Toggle (False = SQLite fallback, True = PostgreSQL connection active)
USE_POSTGRES=False

# PostgreSQL Connection Credentials (fill in if USE_POSTGRES=True)
DB_NAME=aqi_forecast_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
